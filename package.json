{
  "name": "dsh-skill-manager",
  "version": "0.2.0",
  "private": false,
  "description": "DSH 自定义 SKILL 管理：压缩包导入、AI/手动创建、会话挂载与 /mySkills 本轮选择。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dechuan0629/dsh-skill-manager-cdc.git"
  },
  "homepage": "https://github.com/Dechuan0629/dsh-skill-manager-cdc#readme",
  "bugs": {
    "url": "https://github.com/Dechuan0629/dsh-skill-manager-cdc/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib/*.js",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  },
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
